{
  "name": "ai-yutang",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server:dev": "node server/index.mjs",
    "dev:full": "concurrently -n web,api -c blue,green \"npm run dev\" \"npm run server:dev\"",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "NODE_ENV=production node server/index.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "lucide-react": "^0.468.0",
    "morgan": "^1.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1"
  }
}
